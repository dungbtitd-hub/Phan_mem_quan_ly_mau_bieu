# Giá trị minh họa an toàn. Sao chép thành .env và đặt giá trị riêng cho từng môi trường.
POSTGRES_DB=formportal
POSTGRES_USER=formportal_app
POSTGRES_PASSWORD=__DAT_MAT_KHAU_MANH_RIENG__
# Tài khoản Admin khởi tạo (bắt buộc đổi mật khẩu ở lần đăng nhập đầu)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=__DAT_MAT_KHAU_TAM_THOI__
# Giới hạn tệp tải lên (byte): 30 MB
MAX_UPLOAD_BYTES=31457280
# Quét mã độc (tùy chọn). Nếu bật, clamd phải cấu hình StreamMaxLength lớn hơn 30 MB.
CLAMAV_ENABLED=false
# Chỉ đặt khi giao diện chạy khác origin với API (ví dụ http://localhost:5173). Để trống khi dùng Nginx cùng origin.
ALLOWED_ORIGINS=
