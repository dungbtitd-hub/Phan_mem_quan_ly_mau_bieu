# ===== Cấu hình Cổng quản lý mẫu biểu =====
# install.sh tự tạo .env từ tệp này và sinh mật khẩu ngẫu nhiên. Có thể sửa tay trước khi cài.
# Lưu ý: mật khẩu KHÔNG dùng các ký tự  ;  '  "  $  `  khoảng trắng.

# Phiên bản phần mềm (gói cài đặt tự điền)
FP_VERSION=__FP_VERSION__
# Nơi lấy image. Gói offline đã nạp sẵn image với tên này, không cần sửa.
FP_IMAGE_PREFIX=ghcr.io/dungbtitd-hub/phan_mem_quan_ly_mau_bieu

# Database
POSTGRES_DB=formportal
POSTGRES_USER=formportal_app
POSTGRES_PASSWORD=__TU_SINH__

# Tài khoản Admin khởi tạo (chỉ dùng ở lần chạy đầu; bắt buộc đổi mật khẩu khi đăng nhập lần đầu)
# Mật khẩu: >=10 ký tự, có >=3 loại (thường, hoa, số, ký tự đặc biệt), không chứa tên đăng nhập.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=__TU_SINH__

# Cổng mở ra ngoài trên máy chủ
HTTP_PORT=80
HTTPS_PORT=443

# Giới hạn tệp tải lên (byte): tối đa 30 MB
MAX_UPLOAD_BYTES=31457280

# Quét mã độc ClamAV (tùy chọn). Muốn bật: đặt cả hai dòng dưới.
#   COMPOSE_PROFILES=clamav
#   CLAMAV_ENABLED=true
CLAMAV_ENABLED=false

# Chỉ dùng khi thử nghiệm: nạp thêm dữ liệu MINH HỌA (đặt --seed-demo). Để trống trên môi trường thật.
MIGRATE_ARGS=
